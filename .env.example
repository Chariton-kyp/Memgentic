# Memgentic Configuration
# Copy to .env and fill in your values

# --- Storage ---
# MEMGENTIC_DATA_DIR=~/.memgentic/data
# MEMGENTIC_STORAGE_BACKEND=local          # 'local' (file-based Qdrant) or 'qdrant' (server)
# MEMGENTIC_QDRANT_URL=http://localhost:6333
# MEMGENTIC_QDRANT_API_KEY=                # For Qdrant Cloud

# --- Embeddings ---
# MEMGENTIC_EMBEDDING_PROVIDER=ollama      # 'ollama' (local, free) or 'openai'
# MEMGENTIC_OLLAMA_URL=http://localhost:11434
# MEMGENTIC_OPENAI_API_KEY=               # Only if using OpenAI embeddings
#
# Embedding model — run `memgentic setup` to choose interactively, or set manually:
#
#   Default (balanced, ~800MB VRAM, runs on any discrete GPU):
MEMGENTIC_EMBEDDING_MODEL=qwen3-embedding:0.6b
MEMGENTIC_EMBEDDING_DIMENSIONS=768
#
#   Alternatives:
#     qwen3-embedding:4b     — Best quality, needs 4GB+ VRAM (2.5GB download)
#     qwen3-embedding:8b     — Top quality, needs 8GB+ VRAM (5GB download)
#     embeddinggemma:300m    — Google, lightweight, ~500MB VRAM (622MB download)
#     nomic-embed-text       — Compact, ~300MB VRAM, English-focused (274MB download)
#     (custom)               — Any Ollama-compatible embedding model

# --- Performance ---
# MEMGENTIC_EMBEDDING_BATCH_SIZE=8         # Concurrent embedding requests (lower for CPU)
# MEMGENTIC_IMPORT_CONCURRENCY=4           # Files processed in parallel during import

# --- LLM (for summarization) ---
# MEMGENTIC_SUMMARIZATION_MODEL=gemini-2.0-flash-lite
MEMGENTIC_GOOGLE_API_KEY=

# --- Dream (auto-consolidation) ---
# `memgentic dream` runs a two-phase LLM pipeline. See docs/AUTO-DREAM-MODELS.md
# for the full provider matrix and recommended configurations.
#
# Routing is by model-name prefix:
#   claude-* / anthropic/...   -> Anthropic API (needs MEMGENTIC_ANTHROPIC_API_KEY)
#   gemini-* / models/gemini-* -> Google API (needs MEMGENTIC_GOOGLE_API_KEY)
#   gpt-* / o1-* / openai/...  -> OpenAI-compat (needs MEMGENTIC_OPENAI_COMPAT_BASE_URL)
#   anything else              -> Ollama tag (e.g. qwen3.6:35b-a3b, gemma4:e4b,
#                                 hf.co/unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_S)
#   empty string               -> default LLMClient chain
#                                 (Gemini -> OpenAI-compat -> Ollama -> heuristics)

# Anthropic key — required only when any DREAM_* model starts with 'claude-'.
# MEMGENTIC_ANTHROPIC_API_KEY=

# Phase 3 (Consolidate) — generates patches. Quality matters here.
#   Top quality:    claude-sonnet-4-6  (~$0.90/run, default)
#   Cheap cloud:    claude-haiku-4-5   (~$0.10/run, recommended for iteration)
#   Top local:      hf.co/unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_S
#                   (free, MoE 35B/3B-active, ~21 GB RAM, 5/5 schema reliability)
#   Lightweight:    gemma4:26b-a4b     (free, MoE 26B/3.8B-active, ~18 GB RAM)
# MEMGENTIC_DREAM_CONSOLIDATE_MODEL=claude-sonnet-4-6

# Phase 2 (Gather Signal) — bulk transcript scan, single call per dream.
# Cheap by design.
#   Cheap cloud:    claude-haiku-4-5   (default)
#   Cheaper cloud:  gemini-3.1-flash-lite
#   Local light:    gemma4:e4b         (~6 GB RAM)
#   Local tiny:     gemma4:e2b         (~3 GB RAM)
#   ""              Force default LLMClient (uses MEMGENTIC_LOCAL_LLM_MODEL)
# MEMGENTIC_DREAM_SIGNAL_MODEL=claude-haiku-4-5

# Default session count when `memgentic dream run` is invoked without
# --limit-sessions. Capped at 100.
# MEMGENTIC_DREAM_DEFAULT_SESSION_LIMIT=10

# --- Ollama tuning for the dream pipeline (recommended when running locally) ---
# These are not Memgentic settings — they affect any Ollama client. Set in
# your shell profile (Windows: System Properties -> Environment Variables;
# Linux/macOS: ~/.bashrc / ~/.zshrc / systemd unit).
#
#   OLLAMA_KEEP_ALIVE=-1          # Keep models warm between Phase 2 and 3
#   OLLAMA_NUM_PARALLEL=1         # Avoid RAM scaling
#   OLLAMA_FLASH_ATTENTION=1      # CPU acceleration on supported chips
#   OLLAMA_MAX_LOADED_MODELS=2    # When P2 and P3 use different models

# --- Daemon ---
# MEMGENTIC_WATCH_INTERVAL=30             # Seconds between file checks
# MEMGENTIC_IDLE_THRESHOLD=300            # Seconds of inactivity = conversation done

# --- API Authentication ---
# MEMGENTIC_API_KEY=                        # Optional: set to require API key on REST endpoints

# --- MCP Server ---
# MEMGENTIC_MCP_TRANSPORT=stdio            # 'stdio' (local) or 'streamable_http' (remote)
# MEMGENTIC_MCP_PORT=8200
